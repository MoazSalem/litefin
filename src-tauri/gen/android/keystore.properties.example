# =============================================================================
# Android Release Keystore Configuration Template
# =============================================================================
# Copy this file to "keystore.properties" in the same directory (src-tauri/gen/android/).
# "keystore.properties" is already added to .gitignore so your secrets won't be committed.
# =============================================================================

# Path to your .keystore or .jks file (relative to this folder or absolute path with forward slashes)
# Example relative: my-release-key.jks
# Example absolute: C:/Users/YourName/my-release-key.jks
storeFile=my-release-key.jks

# Password for the keystore file
storePassword=yourStorePassword

# The alias of the key inside the keystore
keyAlias=yourKeyAlias

# Password for the specific key alias
keyPassword=yourKeyPassword
