{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Litefin",
  "version": "2.0.150",
  "identifier": "org.litefin.app",
  "build": {
    "beforeDevCommand": "npm run serve:desktop",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Litefin",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "zoomHotkeysEnabled": true,
        "transparent": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
